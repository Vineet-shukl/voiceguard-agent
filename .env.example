# ── LLM providers ─────────────────────────────────────────────────────────
# ONE GOOGLE KEY IS ENOUGH to run the whole pipeline:
#   Gemini reasoning + Google Search grounding + native audio transcription,
#   plus the Fact Check Tools API on the same Cloud project.
# Groq adds faster Whisper ASR and LLM failover. Both are free tiers.

# Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq -> https://console.groq.com/keys  (optional but recommended)
# Preferred for audio transcription (purpose-built Whisper); Gemini native
# audio is used automatically when this is absent.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# OpenRouter (optional third fallback) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Web sources ───────────────────────────────────────────────────────────
# Grounded Google Search (official API, via the Gemini key) is the PRIMARY
# web source. DuckDuckGo scraping is only the keyless fallback.
ENABLE_GOOGLE_GROUNDING=true

# Google Fact Check Tools API. Free. Enable the API on the SAME Google Cloud
# project as your Gemini key, then reuse that key here.
# https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
# If left blank the agent falls back to plain web search (weaker verdicts).
FACTCHECK_API_KEY=

# DuckDuckGo, GDELT and Wikipedia need no keys at all.
ENABLE_WEB_SEARCH=true
ENABLE_NEWS=true
ENABLE_WIKIPEDIA=true
ENABLE_FACTCHECK=true

# ── Remote acoustic detector (the deployed voice-detection-api Space) ─────
# The original Wav2Vec2 + forensics detector runs as its own service. The
# agent calls it over HTTP; if unreachable, the pipeline degrades gracefully
# and scores on web evidence alone.
VOICE_API_URL=https://pandaisop-voice-detection-api.hf.space/test
VOICE_API_KEY=
# Generous default because a sleeping Space can take ~1 min to wake.
VOICE_API_TIMEOUT=75
# Only set this if auto-negotiation can't find the right audio field name.
VOICE_API_AUDIO_FIELD=
ENABLE_REMOTE_DETECTOR=true

# ── Service auth (optional) ───────────────────────────────────────────────
# If set, POST endpoints require this value in an X-API-Key header. Leave
# blank for an open demo endpoint.
AGENT_API_KEY=

# ── Budgets (keep a live demo inside a few seconds) ───────────────────────
HTTP_TIMEOUT=12
LLM_TIMEOUT=45
MAX_CLAIMS=4
MAX_QUERIES_PER_ROUND=6
MAX_RESULTS_PER_QUERY=6
MAX_EVIDENCE=40
